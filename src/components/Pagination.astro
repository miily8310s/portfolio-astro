---
type Props = {
  length: number;
  currentPage: number;
  firstUrl: string;
  prevUrl: string | undefined;
  nextUrl: string | undefined; 
}

const { length, currentPage, firstUrl, prevUrl, nextUrl } = Astro.props;
const paginationList = Array.from({ length }, (_, i) => i +1 )
---

<nav>
  <ol class="flex justify-center font-medium gap-1">
    {
      prevUrl && (
        <li>
          <a href={prevUrl} class="grid place-items-center h-10 w-10 rounded border border-gray-300 dark:border-gray-600 text-zinc-900 dark:text-white hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">{'<'}</a>
        </li>
      )
    }
    {
      paginationList.map((num) => (
        <li>
          <a
            href={`${firstUrl}${num === 1 ? '' : '' + num }`}
            class={`block h-10 w-10 rounded border text-center leading-10 text-zinc-900 dark:text-white transition-colors ${currentPage === num ? 'border-blue-600 bg-blue-600 !text-white' : 'border-gray-300 dark:border-gray-600 hover:bg-gray-100 dark:hover:bg-gray-800'}`}>
            {num}
          </a>
        </li>
      ))
    }
    {
      nextUrl && (
        <li>
          <a href={nextUrl} class="grid place-items-center h-10 w-10 rounded border border-gray-300 dark:border-gray-600 text-zinc-900 dark:text-white hover:bg-gray-100 dark:hover:bg-gray-800 transition-colors">{'>'}</a>
        </li>
      )
    }
  </ol>
</nav>