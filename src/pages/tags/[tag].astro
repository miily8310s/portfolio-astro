---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';

export async function getStaticPaths() {
  const allPosts = await getCollection("blog");
  const uniqueTags = [...new Set(allPosts.map((post) => post.data.tags).flat())];

  return uniqueTags.map((tag) => {
    const filteredPosts = allPosts.filter((post) => post.data.tags.includes(tag));
    return {
      params: { tag },
      props: { posts: filteredPosts },
    };
  });
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---
<BaseLayout pageTitle={tag}>
  <Container>
    <h1 class="text-3xl dark:text-white">Posts tagged with <span class="text-gray-500 dark:text-zinc-200">#{tag}</span></h1>
    <ul class="mt-3 flex flex-col gap-4 dark:text-white">
      {posts.reverse().map((post: any) => <li class="text-xl"><a href={`/blog/${post.slug}`}>{post.data.title}</a></li>)}
    </ul>
  </Container>
</BaseLayout>