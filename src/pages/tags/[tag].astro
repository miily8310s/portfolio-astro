---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import BlogCard from '../../components/BlogCard.astro';

export async function getStaticPaths() {
  const allPosts = await getCollection("blog");
  const uniqueTags = [...new Set(allPosts.map((post) => post.data.tags).flat())];

  return uniqueTags.map((tag) => {
    const filteredPosts = allPosts.filter((post) => post.data.tags.includes(tag));
    return {
      params: { tag },
      props: { posts: filteredPosts },
    };
  });
}

const { tag } = Astro.params;
const { posts } = Astro.props;

const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<BaseLayout pageTitle={tag}>
  <Container>
    <a href="/tags/" class="inline-block mb-4 text-sm text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors">
      ← Back to all tags
    </a>
    
    <div class="mb-8">
      <hgroup class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-linear-to-r from-blue-50 to-indigo-50 dark:from-gray-800 dark:to-gray-700 border-2 border-blue-200 dark:border-gray-600 shadow-sm">
        <h1 class="text-xl md:text-2xl font-bold text-gray-800 dark:text-zinc-100"># {tag}</h1>
        <span class="text-sm md:text-base bg-blue-600 dark:bg-blue-500 text-white px-2.5 py-0.5 rounded-full font-semibold">{posts.length}</span>
      </hgroup>
    </div>
    
    <div class="grid grid-cols-1 gap-8">
      {sortedPosts.map((post) => (
        <BlogCard post={post} />
      ))}
    </div>
  </Container>
</BaseLayout>