---
import Container from '../../components/Container.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<!-- TODO: もう少しデザイン検討 -->
<BaseLayout pageTitle="About Me">
  <Container>
    <article class="max-w-3xl">
      <header class="mb-12">
        <h1 class="text-4xl md:text-5xl font-extrabold mb-6">
          👋<span class="ml-2 text-blue-600 dark:text-blue-400 font-medium">Hello</span>
        </h1>
        <div class="space-y-4">
          <p class="text-lg text-gray-600 dark:text-gray-400 leading-relaxed max-w-2xl">
            Webフロントエンドエンジニアやっています。以前はモバイルもやってました。バックエンドはひよっこ。
          </p>
          <p class="text-lg text-gray-600 dark:text-gray-400 leading-relaxed max-w-2xl">
            I'm a Japanese Frontend Engineer in Osaka, currently focusing on <span class="text-blue-600 dark:text-blue-400 font-medium">Next.js</span>, <span class="text-blue-600 dark:text-blue-400 font-medium">TypeScript</span>. I love building intuitive and beautiful user experiences.
          </p>
        </div>
      </header>

      <div class="space-y-12">
        <section>
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6 flex items-center gap-2">
            <span class="w-8 h-8 rounded-lg bg-blue-100 dark:bg-blue-900/30 flex items-center justify-center text-blue-600 dark:text-blue-400 text-base">💻</span>
            Skills & Interests
          </h2>
          <div class="space-y-6 text-gray-700 dark:text-zinc-200">
            <div>
              <h3 class="text-sm font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400 mb-3">Languages</h3>
              <div class="flex flex-wrap gap-2">
                {['HTML5', 'CSS3', 'JavaScript', 'TypeScript'].map(item => (
                  <span class="px-3 py-1 text-sm rounded-full bg-gray-100 dark:bg-gray-800 border border-gray-200 dark:border-gray-700 font-medium">{item}</span>
                ))}
              </div>
            </div>
            <div>
              <h3 class="text-sm font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400 mb-3">Frameworks</h3>
              <div class="flex flex-wrap gap-2">
                {['React', 'React Native', 'Next.js', 'Astro'].map(item => (
                  <span class="px-3 py-1 text-sm rounded-full bg-blue-50 dark:bg-blue-900/20 text-blue-700 dark:text-blue-300 border border-blue-100 dark:border-blue-800 font-medium">{item}</span>
                ))}
              </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div>
                <h3 class="text-sm font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400 mb-3">Studying</h3>
                <div class="flex flex-wrap gap-2">
                  {['English', 'Golang'].map(item => (
                    <span class="px-3 py-1 text-sm rounded-full bg-green-50 dark:bg-green-900/20 text-green-700 dark:text-green-300 border border-green-100 dark:border-green-800 font-medium">{item}</span>
                  ))}
                </div>
              </div>
              <div>
                <h3 class="text-sm font-bold uppercase tracking-wider text-gray-500 dark:text-gray-400 mb-3">Interested in</h3>
                <div class="flex flex-wrap gap-2 text-sm font-medium">
                   {['Kotlin', 'Flutter', 'Rust'].map(item => (
                    <span class="px-3 py-1 rounded-full bg-purple-50 dark:bg-purple-900/20 text-purple-700 dark:text-purple-300 border border-purple-100 dark:border-purple-800">{item}</span>
                  ))}
                </div>
              </div>
            </div>
          </div>
        </section>

        <section>
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6 flex items-center gap-2">
            <span class="w-8 h-8 rounded-lg bg-orange-100 dark:bg-orange-900/30 flex items-center justify-center text-orange-600 dark:text-orange-400 text-base">✨</span>
            Personal Interests
          </h2>
          <div class="p-6 rounded-xl bg-gray-50 dark:bg-gray-800/50 border border-gray-100 dark:border-gray-700">
            <p class="flex flex-wrap gap-x-4 gap-y-2 text-gray-700 dark:text-gray-300 items-center">
              {[
                { label: 'Coffee', icon: '☕' },
                { label: 'Movie', icon: '🍿' },
                { label: 'Music', icon: '🎸' },
                { label: 'Watching Baseball', icon: '⚾️' },
                { label: 'Quagsire (ヌオー)', icon: '💧🦖' },
              ].map(item => (
                <span class="inline-flex items-center gap-1.5 font-medium">
                  <span class="text-xl">{item.icon}</span> {item.label}
                </span>
              ))}
            </p>
          </div>
        </section>

        <section class="pb-12">
          <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-6 flex items-center gap-2">
            <span class="w-8 h-8 rounded-lg bg-emerald-100 dark:bg-emerald-900/30 flex items-center justify-center text-emerald-600 dark:text-emerald-400 text-base">🌐</span>
            Contact
          </h2>
          <div class="space-y-4">
            <ul class="flex flex-wrap gap-4 pt-2">
              {[
                { label: 'GitHub', url: 'https://github.com/miily8310s', icon: 'github' },
                { label: 'Zenn', url: 'https://zenn.dev/miruoon_892', icon: 'zenn' }
              ].map(link => (
                <li>
                  <a 
                    href={link.url} 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg bg-gray-900 dark:bg-white text-white dark:text-gray-900 font-bold hover:scale-105 transition-all active:scale-95"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </section>
      </div>
    </article>
  </Container>
</BaseLayout>