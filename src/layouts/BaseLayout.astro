---
import Header from "../components/Header.astro";
import Footer from '../components/Footer.astro';
import { SEO } from "astro-seo"
import { ClientRouter } from "astro:transitions";

import "../styles/global.css";

const { pageTitle, pageDescription, ogImage } = Astro.props
const displayTitle = pageTitle ? `${pageTitle} | miruoo's Blog` : `miruoo's Blog`
const ogpTitle = pageTitle ? `${pageTitle} | miruoo's Blog` : `miruoo's Blog - Web/Mobile Development tips`
const displayDescription = pageDescription ? pageDescription : `miruoo's Blog is Blog site about Web/Mobile Development tips`
const canonicalURL = new URL(Astro.url.pathname, Astro.site)
// FIXME: ここのデフォルト画像を切り替えて、昔のは消したい
const resolvedImageWithDomain = ogImage 
  ? new URL(ogImage, Astro.site).toString()
  : new URL("/miruoo's_blog.png", Astro.site).toString();
---

<html lang="ja">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link
      rel="alternate"
      type="application/rss+xml"
      title="miruoo's Blog"
      href={new URL("rss.xml", Astro.site)}
    />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<SEO 
		  title={displayTitle}
			description={displayDescription}
			canonical={canonicalURL}
			openGraph={
			  {
			  	basic: {
			  		url: canonicalURL,
            type: "website",
            title: ogpTitle,
			  		image: resolvedImageWithDomain
			  	},
			  	image: {
			  		alt: displayTitle,
			  	},
					optional: {
						description: displayDescription
					}
			  }
			}
		 />
		<ClientRouter />
	</head>
	<body class="bg-slate-50 dark:bg-[#09090b]">
		<a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:px-4 focus:py-2 focus:bg-blue-600 focus:text-white focus:rounded-md focus:shadow-lg">
			Skip to content
		</a>
		<Header />
		<slot />
		<Footer />
	</body>
</html>
